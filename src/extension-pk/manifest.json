{
  "manifest_version": 3,
  "name": "PK Simple Gmail",
  "version": "2026.10.74",
  "description": "Une interface Gmail plus simple, six thèmes et des réglages à la carte — Made by PK-Labs · mondary.design",
  "permissions": [
    "storage",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://calendar.google.com/*",
    "https://drive.google.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icon.png",
        "themes/*/backgrounds/*.jpg",
        "themes/*/fonts/*.ttf"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PK Simple Gmail",
    "default_icon": "icon.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
