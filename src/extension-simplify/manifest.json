{
  "manifest_version": 3,
  "name": "PK Gmail — Simplify Style",
  "version": "2026.10.15",
  "description": "Une surcouche visuelle pour Gmail : fonds photo, boîte vide immersive, menu compact près du compte et actions Gmail dans leur barre native.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "web_accessible_resources": [{ "resources": ["backgrounds/*.jpg"], "matches": ["https://mail.google.com/*"] }],
  "action": {
    "default_title": "PK Gmail — Simplify Style",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [{
    "matches": ["https://mail.google.com/mail/*"],
    "css": ["gmail.css"],
    "js": ["settings.js", "content.js"],
    "run_at": "document_start"
  }]
}
